{
  "name": "todd-lock-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "build:pages": "vite build --config vite.github-pages.config.ts",
    "refresh:data": "node scripts/refresh-profile.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app github-pages scripts next.config.ts vite.config.ts vite.github-pages.config.ts --format=github",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-profile-loading.cjs && node scripts/test-owner-loading.cjs && node scripts/test-screen-navigation.cjs && node scripts/test-wishlist-export.cjs && node services/lpu-profile-relay/scripts/test-relay.mjs && node services/lpu-profile-relay/scripts/test-background-scans.mjs && node scripts/test-audit-regressions.cjs && node scripts/test-learning.cjs"
  },
  "dependencies": {
    "fflate": "0.7.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.74.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "image-size": "2.0.3",
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
